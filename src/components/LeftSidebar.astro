---
import { SIDEBAR } from '../config';

interface Props {
  currentPage: string;
}

const { currentPage } = Astro.props;

const isActive = (link?: string) => (link ? currentPage.startsWith(link) : false);

// Group links under their section header so each heading precedes its own list
// (a heading directly inside <ul> is invalid list markup, WCAG 1.3.1)
type SidebarItem = (typeof SIDEBAR)[number];
const sections: { header?: string; items: SidebarItem[] }[] = [];
for (const item of SIDEBAR) {
  if (item.header) sections.push({ header: item.text, items: [] });
  else {
    if (!sections.length) sections.push({ items: [] });
    sections[sections.length - 1].items.push(item);
  }
}
---

<nav
  class="w-64 px-4 pt-4 pb-10 overflow-y-auto h-full bg-white dark:bg-slate-darkest"
  aria-label="Documentation navigation"
>
  {
    sections.map(section => (
      <>
        {section.header && (
          <h2 class="mt-5 mb-1 px-2 text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-neutral-light">
            {section.header}
          </h2>
        )}
        <ul>
          {section.items.map(item => (
            <li>
              <a
                href={item.link}
                class:list={[
                  'block py-1.5 px-3 rounded text-sm my-0.5 transition-colors border-l-2',
                  isActive(item.link)
                    ? 'border-blue-medium text-slate-900 dark:text-neutral-lighter font-medium bg-blue-lightest/20 dark:bg-blue-medium/20'
                    : 'border-transparent text-slate-500 dark:text-neutral-light hover:text-slate-900 dark:hover:text-neutral-lighter hover:bg-slate-50 dark:hover:bg-slate-dark',
                ]}
                aria-current={isActive(item.link) ? 'page' : undefined}
                data-drawer-close
              >
                {item.text}
              </a>
            </li>
          ))}
        </ul>
      </>
    ))
  }
</nav>
