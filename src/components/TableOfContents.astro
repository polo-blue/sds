---
const { headers } = Astro.props;
---

<ul class="flex flex-col gap-4 mt-24">
  {
    headers.map(({ slug, text }) => {
      return (
        <li class="text-slate-500 dark:text-neutral-light hover:text-slate-900 dark:hover:text-neutral-lighter">
          #<a href={`#${slug}`}>{text}</a>
        </li>
      );
    })
  }
</ul>
