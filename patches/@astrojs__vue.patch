+// Patched in spoko-design-system (pnpm patch): the upstream lazy regex
+// /defineProps\([\s\S]+?\)/ stopped at the first ")" inside the props object,
+// e.g. in `PropType<(string | X)[]>` or `default() {}`, so the generated TSX had no
+// default export and `astro check` reported "has no exported member 'default'".
+// Scan to the parenthesis that closes the call instead, skipping string literals.
+function extractDefinePropsCall(code) {
+	const start = code.search(/defineProps\(/);
+	if (start === -1) return null;
+	let depth = 0;
+	let quote = null;
+	for (let i = code.indexOf("(", start); i < code.length; i++) {
+		const ch = code[i];
+		if (quote) {
+			if (ch === "\\") i++;
+			else if (ch === quote) quote = null;
+			continue;
+		}
+		if (ch === "'" || ch === '"' || ch === "`") quote = ch;
+		else if (ch === "(") depth++;
+		else if (ch === ")" && --depth === 0) return code.slice(start, i + 1);
+	}
+	return null;
+}
 exports.toTSX = toTSX;
