+// Patched in spoko-design-system (pnpm patch). Upstream extracts a runtime-object
+// `defineProps({...})` with the lazy regex /defineProps\([\s\S]+?\)/ over the script with
+// comments stripped by another regex. The match stops at the first ")" inside the props
+// object (`PropType<(string | X)[]>`, `default() {}`), so the generated TSX has no default
+// export and `astro check` reports "has no exported member 'default'"; and the comment
+// stripping eats everything after "//" in a string such as 'https://...'.
+// This scans the raw script instead: it skips comments, string and template literals and
+// regex literals, finds the first `defineProps(` in code and returns the call up to the
+// parenthesis that closes it, or null (upstream then falls back to untyped props).
+function extractDefinePropsCall(code) {
+	const NAME = "defineProps(";
+	const REGEX_PRECEDERS = "(,=:[!&|?{};+-*%<>~^";
+	let start = -1;
+	let depth = 0;
+	let prev = "";
+	for (let i = 0; i < code.length; i++) {
+		const ch = code[i];
+		const next = code[i + 1];
+		if (ch === "/" && next === "/") {
+			const end = code.indexOf("\n", i);
+			if (end === -1) return null;
+			i = end;
+			continue;
+		}
+		if (ch === "/" && next === "*") {
+			const end = code.indexOf("*/", i + 2);
+			if (end === -1) return null;
+			i = end + 1;
+			continue;
+		}
+		if (ch === "'" || ch === '"' || ch === "`") {
+			i = skipQuoted(code, i, ch);
+			if (i === -1) return null;
+			prev = ch;
+			continue;
+		}
+		if (ch === "/" && (prev === "" || REGEX_PRECEDERS.includes(prev))) {
+			i = skipRegex(code, i);
+			if (i === -1) return null;
+			prev = "/";
+			continue;
+		}
+		if (!/\s/.test(ch)) prev = ch;
+		if (start === -1) {
+			if (code.startsWith(NAME, i) && !/[\w$]/.test(code[i - 1] ?? "")) {
+				start = i;
+				i += NAME.length - 2;
+			}
+			continue;
+		}
+		if (ch === "(") depth++;
+		else if (ch === ")" && --depth === 0) return code.slice(start, i + 1);
+	}
+	return null;
+}
+// Index of the closing quote of the literal opening at `i`, or -1 when it never closes.
+function skipQuoted(code, i, quote) {
+	for (let j = i + 1; j < code.length; j++) {
+		if (code[j] === "\\") j++;
+		else if (code[j] === quote) return j;
+		else if (quote !== "`" && code[j] === "\n") return -1;
+	}
+	return -1;
+}
+// Index of the closing "/" of the regex literal opening at `i` (a "/" inside [...] does not
+// close it), or -1 when it never closes on that line.
+function skipRegex(code, i) {
+	let inClass = false;
+	for (let j = i + 1; j < code.length; j++) {
+		const c = code[j];
+		if (c === "\\") j++;
+		else if (c === "\n") return -1;
+		else if (c === "[") inClass = true;
+		else if (c === "]") inClass = false;
+		else if (c === "/" && !inClass) return j;
+	}
+	return -1;
+}
 exports.toTSX = toTSX;
