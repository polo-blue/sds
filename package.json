{
  "name": "spoko-design-system",
  "version": "2.1.8",
  "type": "module",
  "private": false,
  "main": "./index.ts",
  "module": "./index.ts",
  "types": "./index.ts",
  "files": [
    "index.ts",
    "src",
    "uno-config",
    "uno.config.ts",
    "icon.config.ts",
    "icon-collections.ts",
    "public"
  ],
  "exports": {
    ".": {
      "import": "./index.ts",
      "require": "./index.ts"
    },
    "./styles/tokens.css": "./src/styles/tokens.css",
    "./styles/*": "./src/styles/*",
    "./scripts/*": "./src/scripts/*",
    "./icons": "./icon.config.ts",
    "./icon-collections": "./icon-collections.ts",
    "./uno-config": "./uno-config/index.ts",
    "./components/*": "./src/components/*",
    "./components/ProductDetailName.vue": "./src/components/ProductDetailsListName.vue",
    "./components/Product/product-gallery.css": "./src/components/Product/product-gallery.css",
    "./scripts/product-gallery": "./src/components/Product/product-gallery.ts",
    "./scripts/product-gallery-auto": "./src/scripts/product-gallery-auto.ts",
    "./astro/*": "./src/astro/*",
    "./vue/*": "./src/vue/*",
    "./react/*": "./src/react/*",
    "./utils/*": "./src/utils/*"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "pnpm build:tokens && astro build",
    "build:tokens": "node scripts/build-tokens.ts",
    "build:css": "node scripts/build-css.ts",
    "preview": "astro preview",
    "semantic-release": "semantic-release",
    "prepublishOnly": "pnpm run build",
    "format": "prettier --write \"src/**/*.{js,ts,jsx,tsx,vue,astro,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{js,ts,jsx,tsx,vue,astro,json,css,md}\"",
    "lint": "eslint \"src/**/*.{js,ts,jsx,tsx,vue,astro}\"",
    "lint:fix": "eslint \"src/**/*.{js,ts,jsx,tsx,vue,astro}\" --fix",
    "check": "astro check",
    "test:unit": "node --test \"tests/unit/*.test.ts\"",
    "test:e2e": "playwright test",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/polo-blue/sds"
  },
  "author": {
    "name": "spokospace",
    "email": "szymon@spoko.space",
    "url": "https://spoko.space"
  },
  "homepage": "https://sds.spoko.space/",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "astro-starter",
    "seo",
    "astro",
    "sds design system",
    "spoko design system"
  ],
  "dependencies": {
    "@astrojs/mdx": "^8.1.2",
    "@astrojs/node": "^11.1.9",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/ts-plugin": "^1.10.12",
    "@astrojs/vue": "^7.1.2",
    "@floating-ui/dom": "^1.8.0",
    "@iconify-json/ant-design": "^1.2.9",
    "@iconify-json/bi": "^1.2.7",
    "@iconify-json/bx": "^1.2.3",
    "@iconify-json/carbon": "^1.2.29",
    "@iconify-json/circle-flags": "^1.2.14",
    "@iconify-json/ei": "^1.2.2",
    "@iconify-json/el": "^1.2.2",
    "@iconify-json/eos-icons": "^1.2.4",
    "@iconify-json/et": "^1.2.1",
    "@iconify-json/flowbite": "^1.2.7",
    "@iconify-json/fluent": "^1.2.61",
    "@iconify-json/fluent-emoji": "1.2.7",
    "@iconify-json/ic": "^1.2.4",
    "@iconify-json/icon-park-outline": "^1.2.4",
    "@iconify-json/la": "^1.2.1",
    "@iconify-json/lucide": "^1.2.151",
    "@iconify-json/material-symbols-light": "^1.2.98",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/noto-v1": "^1.2.5",
    "@iconify-json/octicon": "^1.2.40",
    "@iconify-json/ph": "^1.2.2",
    "@iconify-json/simple-icons": "^1.2.101",
    "@iconify-json/streamline": "^1.2.5",
    "@iconify-json/streamline-emojis": "^1.2.4",
    "@iconify-json/streamline-freehand-color": "^1.2.2",
    "@iconify-json/system-uicons": "^1.2.4",
    "@iconify-json/uil": "^1.2.3",
    "@iconify-json/vscode-icons": "^1.2.96",
    "@iconify/utils": "^3.1.7",
    "@iconify/vue": "^5.0.5",
    "@unocss/astro": "66.12.0",
    "@unocss/preset-typography": "66.12.0",
    "@unocss/preset-uno": "66.12.0",
    "@unocss/reset": "66.12.0",
    "@vite-pwa/astro": "^1.2.0",
    "@vueuse/core": "^15.0.0",
    "astro-icon": "^1.2.0",
    "astro-meta-tags": "^0.4.1",
    "astro-pagefind": "^2.0.1",
    "astro-remote": "^0.3.4",
    "culori": "^4.0.2",
    "sharp": "^0.35.5",
    "swiper": "^14.4.0",
    "unocss": "66.12.0",
    "vite-plugin-pwa": "^1.3.0",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/culori": "^4.0.1",
    "@types/gtag.js": "^0.0.20",
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@unocss/transformer-variant-group": "66.12.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/compiler-sfc": "^3.5.44",
    "@vue/eslint-config-typescript": "^14.9.0",
    "astro": "^7.4.5",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jscpd": "^5.4.2",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "semantic-release": "^25.0.9",
    "typescript": "^6.0.3",
    "vite": "^8.3.5"
  },
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22.23.4",
    "pnpm": ">=10.16.1"
  }
}
