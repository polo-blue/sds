# Keep LF everywhere so Prettier (endOfLine: lf) agrees with the checkout on Windows
* text=auto eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.avif binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary

# pnpm patch files are unified diffs of tab-indented upstream code: their context lines
# start with a space before a tab, which `git diff --check` (the pre-commit hook) rejects.
patches/*.patch -whitespace
